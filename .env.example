# Copia este fichero a .env y rellena lo que tengas. Cada fuente es opcional:
# la que falte sale como «sin datos» y su icono no aparece.

# Subsonic (Airsonic, Navidrome, Gonic…): ¿está en tu biblioteca?
AIRSONIC_URL=
AIRSONIC_USER=
AIRSONIC_PASS=

# qBittorrent: ¿lo estás descargando? Si corre en el mismo equipo que Docker,
# QB_HOST=host.docker.internal
QB_HOST=
QB_PORT=8080
QB_USER=
QB_PASS=

# Carpetas del anfitrión donde están las bases que se leen (solo lectura):
#  - lastfm_stats.db, que crea https://github.com/volteret4/lastfm_scrobbles
#  - library.db, que crea https://github.com/volteret4/mixxx_info
LASTFM_DIR=./datos/lastfm
MIXXX_DIR=./datos/mixxx

# Puerto del anfitrión
PUERTO=8780
